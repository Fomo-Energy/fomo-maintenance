{
  "name": "fomo-maintenance",
  "version": "1.0.0",
  "private": true,
  "description": "Fomo Maintenance — FOMO Energy annual solar O&M program in Singapore",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify": "npm run verify:pricing && npm run verify:slots && npm run verify:calendar && npm run verify:database && npm run verify:portal && npm run verify:documents && npm run verify:rescheduling && npm run verify:email && npm run verify:deployment-environment && npm run verify:staging-ui",
    "verify:pricing": "tsx scripts/verify-pricing.ts",
    "verify:slots": "tsx scripts/verify-slots.ts",
    "verify:calendar": "tsx scripts/verify-calendar.ts",
    "verify:database": "drizzle-kit check && tsx scripts/verify-database.ts",
    "verify:portal": "tsx scripts/verify-portal.ts",
    "verify:documents": "tsx scripts/verify-documents.ts",
    "verify:rescheduling": "tsx scripts/verify-rescheduling.ts",
    "verify:email": "tsx scripts/verify-email.ts",
    "verify:deployment-environment": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-deployment-environment.ts",
    "verify:staging-ui": "tsx scripts/verify-staging-ui.tsx",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "5.9"
  }
}
