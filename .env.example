# Copy to .env.local. Do not commit secrets.

# Stripe (Checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Active, exclusive 9% Singapore GST manual tax rate. Test and live modes use
# different tax-rate IDs; set the ID that matches STRIPE_SECRET_KEY.
STRIPE_GST_TAX_RATE_ID=

# Public site origin used in Stripe success/cancel URLs (no trailing slash).
# On Vercel, https://$VERCEL_URL is used if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres booking and API-safety datastore. Apply every reviewed migration
# before enabling reservations, rate limits, or the customer portal.
DATABASE_URL=
# At least 32 random bytes. Server-only; rotating it invalidates manage links.
MANAGE_LINK_SECRET=
# Exact value 1 enables database-backed fulfilment and manage-page access.
BOOKING_PORTAL_ENABLED=0
# Exact value 1 enables database-first Checkout slot holds even when the
# customer Manage Booking portal is disabled.
CHECKOUT_RESERVATIONS_ENABLED=0
# Exact value 1 enables database-backed limits on public availability and
# Checkout requests. Use a distinct random secret of at least 32 bytes in each
# environment; rotating it resets the anonymous IP-derived buckets.
API_RATE_LIMITING_ENABLED=0
RATE_LIMIT_HASH_SECRET=
# Exact value 1 enables signed refund/dispute lifecycle processing. Requires
# BOOKING_PORTAL_ENABLED=1, migrated durable booking state, and matching Stripe
# webhook subscriptions/key read permissions.
PAYMENT_LIFECYCLE_ENABLED=0

# Private Vercel Blob store for customer PV documents. Vercel injects the
# read/write token when the store is connected to this project.
BLOB_READ_WRITE_TOKEN=
# Exact value 1 permits new document-upload tokens. Existing authenticated
# downloads remain available when this is 0.
DOCUMENT_UPLOADS_ENABLED=0
# Exact value 1 permits authenticated customers to change only their visit
# date/time under the server-side 48-hour and two-change policy.
RESCHEDULING_ENABLED=0

# Microsoft Graph transactional booking/reschedule email. Use a dedicated app
# registration with Mail.Send application permission and restrict it to the
# service mailbox. Keep disabled until the migration and inbox tests pass.
EMAIL_GRAPH_TENANT_ID=
EMAIL_GRAPH_CLIENT_ID=
EMAIL_GRAPH_CLIENT_SECRET=
EMAIL_GRAPH_SENDER_USER=service@fomo.energy
TRANSACTIONAL_EMAIL_ENABLED=0
EMAIL_REPLY_TO=service@fomo.energy
# Comma-separated internal recipients. Add finance only after approval.
EMAIL_OPERATIONS_TO=ops@fomo.energy
# Optional Preview-only safety override. Forbidden in Production; when set,
# every customer message goes to this controlled test inbox.
EMAIL_CUSTOMER_OVERRIDE_TO=

# Microsoft Graph (application / client-credentials)
# Permission: Calendars.ReadWrite (application), admin consent.
# Ops mailbox: Julius Tan FOMO Energy Outlook.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_USER=jtan@fomo.energy

# Paid visits are written only to this secondary calendar. Availability checks
# combine this calendar with the mailbox's primary calendar.
MICROSOFT_MAINTENANCE_CALENDAR_NAME=Fomo Maintenance

# Optional: set the Graph calendar ID to skip lookup by name. Prefer this in
# production if the calendar might be renamed.
MICROSOFT_MAINTENANCE_CALENDAR_ID=
